* text=auto eol=lf

# Repository text formats
*.cff text eol=lf
*.csv text eol=lf
*.ipynb text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Native Windows command files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts and scientific data containers
*.gif binary
*.h5 binary
*.hdf5 binary
*.ico binary
*.jpeg binary
*.jpg binary
*.npy binary
*.npz binary
*.pdf binary
*.png binary
*.whl binary
*.zip binary
